---
const { toc, languageURL, languageText } = Astro.props;
---

<aside>
  <nav class="md:sticky md:h-screen md:overflow-y-auto mt-4 top-0" aria-label="Contents">
    <h2
      id="toc"
      class="font-semibold text-2xl mt-5 border-b border-solid border-fateGray-light pb-2"
    >
      The Book of Hanz
      <a
        href={languageURL}
        class="block pt-1 text-sm font-normal italic text-fateBlue hover:text-fateBlue-darker hover:underline"
      >
        {languageText}
      </a>
    </h2>
    <ul class="divide-y divide-fateGray-light">
      {
        toc.map((item) => (
          <li class="py-2">
            <a
              href={`#${item.id}`}
              class="text-fateBlue hover:text-fateBlue-darker hover:underline"
            >
              {item.value}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
