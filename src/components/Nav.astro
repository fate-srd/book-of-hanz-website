---
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";

const links = [
  { href: "/", label: "Book of Hanz" },
  {
    href: "/apocrypha/20130204-Justa-random-thought_One-of-the-thin",
    label: "Apocrypha",
    match: "/apocrypha",
  },
  { href: "/about", label: "About" },
  { href: "/licensing", label: "Licensing" },
];

function isCurrent(link) {
  if (link.match) return path.startsWith(link.match);
  return path === link.href;
}
---

<nav class="bg-fateBlue-darker text-white text-xl font-semibold" aria-label="Primary">
  <ul class="flex flex-row flex-nowrap py-2 md:py-3 px-2 md:px-5">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link) ? "page" : undefined}
            class="text-base text-white md:text-xl px-2 md:px-5 py-2 hover:bg-fateBlue-darkest aria-[current=page]:bg-fateBlue-darkest transition-colors rounded mr-2 whitespace-nowrap"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
